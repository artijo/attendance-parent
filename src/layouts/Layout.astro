---
import "../global.css";
import Profile from "../components/Profile";
---

<!doctype html>
<html lang="th" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
		<link rel="icon" type="image/svg+xml" href="/favicon.ico" />
		<meta name="theme-color" content="#0054A6">
		<meta name="apple-mobile-web-app-capable" content="yes">
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
		<title>ระบบลงทะเบียนรับการแจ้งเตือนการเข้าเรียนและกิจกรรมจองนักเรียน สำหรับผู้ปกครอง</title>
	</head>
	<body class="min-h-screen flex flex-col bg-bg text-text">
		<!-- หน้าโหลดที่จะแสดงระหว่างรอ LIFF โหลด -->
		<div id="loading-screen" class="fixed inset-0 bg-bg flex flex-col items-center justify-center z-50">
			<img src="/Logo_NPS.png" alt="School Logo" class="h-16 sm:h-20 w-auto mb-6" />
			<div class="animate-spin rounded-full h-12 w-12 sm:h-16 sm:w-16 border-4 border-primary border-t-transparent mb-4"></div>
			<h2 class="text-lg sm:text-xl font-bold text-primary mb-1">กำลังโหลด</h2>
			<p class="text-sm text-text-alt">กรุณารอสักครู่...</p>
		</div>
		
		<!-- เนื้อหาหลักที่จะแสดงเมื่อโหลดเสร็จ -->
		<main id="main-content" class="flex-grow container mx-auto px-3 sm:px-4 md:px-6 py-4 sm:py-6 hidden">
			<header class="bg-gradient-to-r from-primary to-accent text-white p-4 sm:p-6 rounded-lg shadow-md mb-4 sm:mb-6">
				<div class="flex items-center justify-between">
					<div class="flex items-center space-x-2 sm:space-x-3">
						<img src="/Logo_NPS.png" alt="School Logo" class="h-10 sm:h-12 w-auto" />
						<h1 class="text-xl sm:text-2xl md:text-3xl font-bold leading-tight">
							<span class="block sm:hidden">ระบบแจ้งเตือนผู้ปกครอง</span>
							<span class="hidden sm:block">ระบบลงทะเบียนรับการแจ้งเตือน</span>
							<span class="text-base sm:text-xl md:text-2xl hidden sm:block">การเข้าเรียนและกิจกรรมจองนักเรียน สำหรับผู้ปกครอง</span>
						</h1>
					</div>
				</div>
			</header>
			
			<Profile client:load />
			
			<div class="bg-white rounded-lg shadow-md p-4 sm:p-6 mb-4 sm:mb-6 mt-4 sm:mt-6 overflow-hidden">
				<slot/>
			</div>
			
			<footer class="bg-bg-alt text-white p-3 sm:p-4 rounded-lg mt-auto text-xs sm:text-sm">
				<div class="container mx-auto flex flex-col md:flex-row justify-between items-center">
					<p class="text-center md:text-left mb-2 md:mb-0">&copy; {new Date().getFullYear()} ระบบลงทะเบียนรับการแจ้งเตือนการเข้าเรียนและกิจกรรมจองนักเรียน</p>
					<div class="flex space-x-4">
						<a href="#" class="hover:text-secondary transition-colors">นโยบาย</a>
						<a href="#" class="hover:text-secondary transition-colors">ติดต่อเรา</a>
					</div>
				</div>
			</footer>
		</main>
		<script>
			import liff from "@line/liff";
			import { HOSTNAME } from "../config.js";
			
			// สร้างฟังก์ชันที่จะส่งข้อมูลไป backend เมื่อมี userId แล้วเท่านั้น
			async function sendUserDataToBackend(userId, profile) {
				try {
					if (!userId) {
						console.error("userId is undefined or null");
						return;
					}
					
					console.log("Sending user data to backend:", { userId, displayName: profile.displayName });
					
					const response = await fetch(`${HOSTNAME}/p/create`, {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json',
						},
						body: JSON.stringify({
							userId: userId,
							liffId: liff.getVersion(),
							accessToken: liff.getAccessToken(),
							displayName: profile.displayName,
						}),
					});
					
					if (!response.ok) {
						throw new Error(`Network response error: ${response.status}`);
					}
					
					const data = await response.json();
					console.log("Backend response:", data);
					
				} catch (error) {
					console.error("Error sending user data to backend:", error);
				}
			}			// ฟังก์ชันสำหรับแสดง/ซ่อนหน้าโหลด
			function showLoadingScreen(show = true) {
				const loadingScreen = document.getElementById('loading-screen');
				const mainContent = document.getElementById('main-content');
				
				if (loadingScreen && mainContent) {
					if (show) {
						loadingScreen.classList.remove('hidden');
						mainContent.classList.add('hidden');
					} else {
						loadingScreen.classList.add('hidden');
						mainContent.classList.remove('hidden');
					}
				}
			}
			
			async function initLiff() {
				try {
					// แสดงหน้าโหลดก่อน
					showLoadingScreen(true);
					
					// รอให้ LIFF init เสร็จสิ้น
					await liff.init({ liffId: '2006049603-5Ne6yzM4'});
					console.log("LIFF initialization completed");
					
					// ใช้ liff.ready() เพื่อรอให้ SDK พร้อมใช้งานอย่างสมบูรณ์
					await liff.ready;
					console.log("LIFF is ready");
					
					if (!liff.isLoggedIn()) {
						console.log("User not logged in. Redirecting to LINE login...");
						liff.login();
						return;
					}
					
					// ตรวจสอบว่าได้ context หรือไม่
					const profile = await liff.getProfile();
					if (!profile) {
						console.error("LIFF profile is undefined");
						return;
					}
					
					// บันทึก userId เพื่อใช้ในการส่งข้อมูลไป backend
					const userId = profile.userId;
					if (!userId) {
						console.error("userId is not available from context");
						return;
					}
					
					
					// ส่งข้อมูลไป backend เมื่อมีทั้ง userId และ profile แล้ว
					await sendUserDataToBackend(userId, profile);
					
					// เก็บข้อมูลไว้ใน sessionStorage เพื่อให้สามารถใช้ในคอมโพเนนต์อื่นได้
					sessionStorage.setItem("lineUserId", userId);
					sessionStorage.setItem("lineProfile", JSON.stringify(profile));
					
					// เก็บเวลาที่บันทึกข้อมูลล่าสุด
					sessionStorage.setItem("profileLastUpdated", new Date().toISOString());
					
					// ซ่อนหน้าโหลดและแสดงเนื้อหาหลักเมื่อทุกอย่างพร้อม
					showLoadingScreen(false);
							} catch (error) {
					console.error("Error in LIFF initialization:", error);
					
					// แสดงข้อผิดพลาดที่หน้าโหลด
					const loadingScreen = document.getElementById('loading-screen');
					if (loadingScreen) {
						// แสดงข้อความแสดงข้อผิดพลาด
						const errorElement = document.createElement('div');
						errorElement.className = 'mt-4 p-3 bg-red-100 text-red-700 rounded-lg text-center max-w-md';
						errorElement.innerHTML = `
							<p class="font-bold mb-1">เกิดข้อผิดพลาด</p>
							<p class="text-sm">ไม่สามารถโหลดข้อมูลได้ โปรดลองใหม่อีกครั้ง</p>
							<button id="retryButton" class="mt-2 px-3 py-1 bg-red-600 text-white rounded hover:bg-red-700 text-sm">ลองใหม่</button>
						`;
						loadingScreen.querySelector('p').replaceWith(errorElement);
						
						// ซ่อนการ loading
						const loadingSpinner = loadingScreen.querySelector('.animate-spin');
						if (loadingSpinner) {
							loadingSpinner.classList.add('hidden');
						}
						
						// เพิ่ม event listener สำหรับปุ่มลองใหม่
						document.getElementById('retryButton').addEventListener('click', () => {
							window.location.reload();
						});
					}
				}
			}
					// เริ่มการทำงานเมื่อ DOM พร้อม
			document.addEventListener("DOMContentLoaded", () => {
				console.log("DOM loaded, initializing LIFF...");
				// ตั้งค่า timeout เพื่อตรวจสอบว่าโหลดนานเกินไปหรือไม่
				const timeout = setTimeout(() => {
					// ถ้าใช้เวลาเกิน 10 วินาทีแล้วยังโหลดไม่เสร็จ
					const loadingScreen = document.getElementById('loading-screen');
					if (loadingScreen && !loadingScreen.classList.contains('hidden')) {
						const warningElement = document.createElement('p');
						warningElement.className = 'text-yellow-600 mt-2';
						warningElement.textContent = 'การโหลดอาจใช้เวลานานกว่าปกติ โปรดรอสักครู่...';
						loadingScreen.appendChild(warningElement);
					}
				}, 10000); // 10 วินาที

				// เรียกใช้ initLiff
				initLiff();
				
				// ยกเลิก timeout หากมีการคลิกที่หน้าจอ (แสดงว่าผู้ใช้กำลังโต้ตอบ)
				document.addEventListener("click", () => {
					clearTimeout(timeout);
				});
			});
		</script>
	</body>
</html>

<style is:global>
	:root {
		--color-primary: #0054A6;
		--color-accent: #1262a5;
		--color-secondary: #EE722A;
	}
	
	/* Add responsive Tailwind utilities */
	@media (max-width: 640px) {
		header h1 {
			font-size: 1.25rem;
		}
		
		.small-text {
			font-size: 0.75rem;
		}
		
		/* แทรกการตัด text ที่ยาวให้แสดง ... */
		.truncate-text {
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}
	}
</style>
